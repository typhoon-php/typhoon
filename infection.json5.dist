{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "phpUnit": {
        "customPath": "tools/phpunit/vendor/bin/phpunit"
    },
    "source": {
        "directories": [
            "src/ChangeDetector",
            "src/Type",
            "src/TypedMap",
        ]
    },
    "logs": {
        "text": "var/infection.log",
        "stryker": {
            "report": "/^\\d+\\.\\d+\\.x$/"
        },
    },
    "tmpDir": "var",
    "minCoveredMsi": 95,
    "mutators": {
        "@default": true,
        "CastInt": false, // Usually covered by Psalm
    },
    "testFrameworkOptions": "--testsuite=infection"
}
