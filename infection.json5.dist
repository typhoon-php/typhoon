{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "phpUnit": {
        "customPath": "tools/phpunit/vendor/bin/phpunit"
    },
    "source": {
        "directories": [
            "src/ChangeDetector",
            "src/TypedMap"
        ]
    },
    "logs": {
        "html": "var/infection_report.html",
        "stryker": {
            "report": "/^\\d+\\.\\d+\\.x$/"
        }
    },
    "tmpDir": "var",
    "minCoveredMsi": 80,
    "mutators": {
        "@default": true
    },
    "testFrameworkOptions": "--testsuite=ChangeDetector,TypedMap"
}
